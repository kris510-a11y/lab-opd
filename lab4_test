import pytest
from app import app, check_user

@pytest.fixture
def client():
    app.config['TESTING'] = True
    with app.test_client() as client:
        yield client

def test_check_user_correct():
    assert check_user("user", "qwerty") == True

def test_check_user_wrong_password():
    assert check_user("user", "wrong") == False

def test_check_user_nonexistent():
    assert check_user("fake_user", "123") == False

def test_login_page_loads(client):
    response = client.get('/')
    assert response.status_code == 200
    assert "Авторизация" in response.data.decode('utf-8')

def test_successful_login(client):
    response = client.post('/', data={
        'username': 'user',
        'password': 'qwerty'
    }, follow_redirects=True)
    assert response.status_code == 200
    assert "Добро пожаловать" in response.data.decode('utf-8')

def test_failed_login(client):
    response = client.post('/', data={
        'username': 'user',
        'password': 'wrong'
    })
    assert "Неверный логин или пароль" in response.data.decode('utf-8')

if __name__ == "__main__":
    pytest.main()
